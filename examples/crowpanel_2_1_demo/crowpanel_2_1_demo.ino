#include <crowpanel_2_1.h>

//! A demo program leveraging the Crowpanel_2.1 Arduino library
/*!
  The program displays a curved slider to control the brightness of the LCD display
  of the Crowpanel 2.1".

  A desired brightness is set by clicking on the slider. The target brightness marker
  will move to the selected target value and the brightness of the LCD will gradually
  change to match the target value. The actual brightness of the display is indicated
  by a solid circle while the target marker is indicated by a hollow circle.

  The target marker can also be dragged with normal touchscreen drag gestures, 
  demonstrating the use of LVGL input device callbacks to process touchscreen signals.

  The target brightness can also be changed by rotating the encoder. A clockwise
  rotation increases brightness while a counterclockwise will decrease it. This
  demonstrates the use of the encoder 

  The brightness can be reset to its initial value by holding the encoder down for
  1 second or more, demonstrating one of the 3 possible click callbacks from the
  encoder.

  Set the following in Arduino IDE:

    Board type: ESP32S3 Dev Module (add this library if needed: https://espressif.github.io/arduino-esp32/package_esp32_index.json )
    USB CDC On Boot: Enabled
    Flash size: 16MB
    PSRAM: OPI PSRAM
    Partition Scheme: Huge App
*/

#include <math.h>
#include <crowpanel_2_1.h>

// This is the UI code generated by Squareline Studios
// The design of the UI can be found in the SPJ folder
#include "src/ui/ui.h"

// UI variables
lv_color_t themeColor = lv_color_hex(0x847E71);
lv_obj_t *arcScale, *scaleMarker;
int32_t scaleRadius;

// Variables to hold current display brightness and target brightness value
uint8_t currentDisplayBrightness, targetDisplayBrightness;

// Pointer to Crowpanel controller object
Crowpanel& panel = Crowpanel::getInstance();

// Forward declarations
void handleEncoderRotationAction(int);
void scaleClickEventCallback(lv_event_t * e);
void setScaleMarkerValue(int32_t value);
void scaleDragEventCallback(lv_event_t * e);

/**
 * @brief Initialization of the Crowpanel device and creation of the UI
 * @details Called by the Arduino framework at the beginning of a program
 * @return void
 */
void setup() {
  
  // So our debugging output can go to Serial
  Serial.begin(115200);
  while(!Serial) delay(100);

  // Initialize our debugging framework but suppress all debugging output to
  // preserve performance (call debug.begin(true) to see all the messages)
  debug.begin(false);
  debug << "Debug framework initialized" << endl;

  // Initialize the Crowpanel object
  panel.begin();
  
  // Set display rotation (that's for my setup -- you may want to remove this)
  panel.setDisplayRotation(Crowpanel::DisplayRotation::ROTATION_90_CCW);

  // Set initial display brightness (otherwise it defaults to 255)
  panel.setBacklight(currentDisplayBrightness = 200);

  // Initialize the Squareline Studios-generated UI
  ui_init();
  
  // Add a scale to the brightness arc (note: Squareline Studios does not
  // support LVGL scale objects so we need to create it manually)
  arcScale = lv_scale_create(ui_brightnessArc); 

  // Scale position and size of arc to match the arc in the UI
  lv_obj_set_size(arcScale, lv_pct(100), lv_pct(100)); 
  lv_obj_center(arcScale);
  lv_scale_set_mode(arcScale, LV_SCALE_MODE_ROUND_INNER);
  int32_t startAngle = lv_arc_get_bg_angle_start(ui_brightnessArc);
  int32_t endAngle   = lv_arc_get_bg_angle_end(ui_brightnessArc);
  int32_t sweepRange = endAngle - startAngle;
  if(sweepRange < 0) {
      sweepRange += 360;
  }
  lv_scale_set_rotation(arcScale, startAngle);
  lv_scale_set_angle_range(arcScale, sweepRange);

  // Scale colors and line styles
  lv_obj_set_style_text_color(arcScale, themeColor, LV_PART_MAIN); // Labels
  lv_obj_set_style_arc_color(arcScale, themeColor, LV_PART_MAIN); // Main arc line
  lv_obj_set_style_line_color(arcScale, themeColor, LV_PART_MAIN);
  lv_obj_set_style_line_color(arcScale, themeColor, LV_PART_ITEMS);
  lv_obj_set_style_line_color(arcScale, themeColor, LV_PART_INDICATOR);
  lv_obj_set_style_text_color(arcScale, themeColor, LV_PART_MAIN);
  lv_obj_set_style_text_font(arcScale, &lv_font_montserrat_20, LV_PART_MAIN);
  lv_obj_set_style_length(arcScale, 10, LV_PART_ITEMS); // Minor ticks
  lv_obj_set_style_line_width(arcScale, 1, LV_PART_ITEMS);
  lv_obj_set_style_length(arcScale, 15, LV_PART_INDICATOR); // Major ticks
  lv_obj_set_style_line_width(arcScale, 2, LV_PART_INDICATOR);
  lv_obj_set_style_pad_radial(arcScale, 15, LV_PART_INDICATOR); 

  // Range, tickmarks, and labels
  lv_scale_set_range(arcScale, 
    lv_arc_get_min_value(ui_brightnessArc), 
    lv_arc_get_max_value(ui_brightnessArc));
  lv_scale_set_total_tick_count(arcScale, 101);  // 11 ticks (0, 100, 200... 1000)
  lv_scale_set_major_tick_every(arcScale, 10);   // Make every tick major to get a number
  lv_scale_set_label_show(arcScale, true);

  // Cause arc to be laid out so its radius can be calculated
  lv_obj_update_layout(ui_brightnessArc);
  scaleRadius = lv_obj_get_width(ui_brightnessArc) / 2 
                - lv_obj_get_style_pad_left(arcScale, LV_PART_MAIN) 
                - 6;
  
  // Set a marker on the arc for the target brightness value
  scaleMarker = lv_obj_create(ui_backgroundImage);
  int32_t circle_diameter = 36;
  lv_obj_set_size(scaleMarker, circle_diameter, circle_diameter);
  lv_obj_set_style_radius(scaleMarker, LV_RADIUS_CIRCLE, 0); // Make it a circle
  lv_obj_set_style_bg_opa(scaleMarker, LV_OPA_TRANSP, 0);    // Transparent center
  lv_obj_set_style_border_color(scaleMarker, lv_color_hex(0xFFFFFF), 0); // Ring color white
  lv_obj_set_style_border_width(scaleMarker, 4, 0);          // Ring thickness
  lv_obj_set_style_pad_all(scaleMarker, 0, 0);               // Remove inner padding
  lv_obj_set_clickable(scaleMarker, true);
  lv_obj_set_ext_click_area(scaleMarker, 15); // Make clickable area larger than marker so it's easy to drag
  lv_obj_move_to_index(scaleMarker, -1);

  // Enable dragging of the scale marker
  lv_obj_add_event_cb(scaleMarker, scaleDragEventCallback, LV_EVENT_PRESSING, NULL);
  
  // Enable click events on the scale object  
  lv_obj_set_clickable(arcScale, true);
  lv_obj_add_event_cb(arcScale, scaleClickEventCallback, LV_EVENT_CLICKED, NULL);

  // Set up callbacks for rotary button and encoder actions
  panel.registerLongPressActionCallback(resetBrightnessCallback);
  panel.registerEncoderRotationActionCallback(handleEncoderRotationAction);

  // Initialize target brightness value to position the marker on the UI
  setTargetBrightness(currentDisplayBrightness);
}

/**
 * @brief Sets the target brightness and updates the marker and label
 * accordingly
 * @param [in] value The desired brightness level (0-255)
 * @return void
 */
void setTargetBrightness(uint8_t value) {

  debug << "Setting target brightness to " << value << endl;

  // Record the new target value
  targetDisplayBrightness = value;

  // Update the UI by writing the target value and positioning the 
  // target marker on the arc
  lv_label_set_text_fmt(ui_targetBrightnessLabel, "%d", value);
  setScaleMarkerValue(value);
}

/**
 * @brief Positions the scale marker at a given screen angle
 * @param [in] angle_rad The angle in radians where to put the marker,
 * with 0 being the 3 o'clock position and moving clockwise
 * @return void
 */
void setScaleMarkerAtScreenAngle(float angle_rad) {
    // Calculate Cartesian offset from center of the arc
    int32_t xOffset = (int32_t)((float)scaleRadius * cosf(angle_rad));
    int32_t yOffset = (int32_t)((float)scaleRadius * sinf(angle_rad));

    // Align the marker's center directly on the calculated point
    lv_obj_align(scaleMarker, LV_ALIGN_CENTER, xOffset, yOffset);
}

/**
 * @brief Moves the scale marker to a given value on the scale
 * @param [in] value The value on the scale where to posiiton the marker
 * @return void
 */
void setScaleMarkerValue(int32_t value) {
    // Get min/max and sweep angle parameters of the scale
    int32_t startAngle = lv_arc_get_bg_angle_start(ui_brightnessArc);
    int32_t endAngle   = lv_arc_get_bg_angle_end(ui_brightnessArc);
    int32_t sweepRange = endAngle - startAngle;
    if(sweepRange < 0) {
        sweepRange += 360;
    }
    int32_t min_val = lv_arc_get_min_value(ui_brightnessArc);
    int32_t max_val = lv_arc_get_max_value(ui_brightnessArc);

    // 1. Calculate angle corresponding to the value
    int32_t screenAngle = startAngle + ((value - min_val) * sweepRange) / (max_val - min_val);

    // 2. Convert angle to radians
    float rad = (float)screenAngle * (3.14159265f / 180.0f);

    // 3. Move marker to calculated angle position
    setScaleMarkerAtScreenAngle(rad);
}

/**
 * @brief Convert a picked point on the screen to a value on the
 * scale
 * @param [in] click_point A point object containing the coordinates
 * of the clicked area on the scale
 * @return The value at the picked point
 */
int32_t screenCoordsToScaleValue(lv_point_t click_point) {
  lv_area_t scale_area;
  lv_obj_get_coords(arcScale, &scale_area);
  int32_t center_x = scale_area.x1 + lv_area_get_width(&scale_area) / 2;
  int32_t center_y = scale_area.y1 + lv_area_get_height(&scale_area) / 2;

  float dx = (float)(click_point.x - center_x);
  float dy = (float)(click_point.y - center_y);

  float angle = atan2f(dy, dx) * (180.0f / 3.14159265f);
  if (angle < 0.0f) {
      angle += 360.0f;
  }

  int32_t startAngle = lv_arc_get_bg_angle_start(ui_brightnessArc);
  int32_t endAngle   = lv_arc_get_bg_angle_end(ui_brightnessArc);
  int32_t sweepRange = endAngle - startAngle;
  if (sweepRange < 0) sweepRange += 360;

  float relativeAngle = angle - (float)startAngle;
  if(relativeAngle < 0.0f) relativeAngle += 360.0f;

  int32_t min_val = lv_arc_get_min_value(ui_brightnessArc);
  int32_t max_val = lv_arc_get_max_value(ui_brightnessArc);

  int32_t selectedValue = min_val + (int32_t)((relativeAngle / (float)sweepRange) * (max_val - min_val));

  // Clamp value safety bounds
  if (selectedValue < min_val) selectedValue = min_val;
  if (selectedValue > max_val) selectedValue = max_val;

  return selectedValue;
}

/**
 * @brief Sets the target brightness to the value clicked on the scale
 * @param [in] click_point A point object containing the coordinates
 * of the clicked area on the scale
 * @return void
 */
void setTargetBrightness_from_click(lv_point_t click_point) {
  setTargetBrightness(screenCoordsToScaleValue(click_point));
}

/**
 * @brief The callback function when the scale is touched which
 * sets the target brightness value to the value touched
 * @param [in] e An event object. Not used but required by LVGL.
 * @return void
 */
void scaleClickEventCallback(lv_event_t * e) {

  lv_indev_t * indev = lv_indev_active();
  if(!indev) return;
  
  lv_point_t click_point;
  lv_indev_get_point(indev, &click_point);

  debug << "Scale clicked at position x=" << click_point.x << " y=" << click_point.y << endl;

  setTargetBrightness_from_click(click_point);
}

/**
 * @brief The callback function for touchscreen drag
 * events on our target brightness marker
 * @param [in] e An event object. Not used but required by LVGL.
 * @return void
 */
void scaleDragEventCallback(lv_event_t * e) {
  lv_indev_t * indev = lv_indev_active();
  if(!indev) return;
  
  lv_point_t vect;
  lv_indev_get_vect(indev, &vect);

  // Static variables to remember tiny movements across frames
  static int32_t accum_x = 0;
  static int32_t accum_y = 0;

  accum_x += vect.x;
  accum_y += vect.y;

  debug << "Dragging by x=" << vect.x << " y=" << vect.y << endl;

  // Only trigger a display update if total movement is >= 3 pixels
  // This is to avoid overloading the I2C bus with LVGL updates
  // when the user is just trying to hold the marker steady and not move it,
  // or just barely moves it.
  if(abs(accum_x) < 3 && abs(accum_y) < 3) return;

  accum_x = 0;
  accum_y = 0;

  // If we're here, there was a significant movement, so update the
  // marker position and target weight
  lv_point_t click_point;
  lv_indev_get_point(indev, &click_point);

  setTargetBrightness_from_click(click_point);
}

/**
 * @brief The callback function for long press events
 * @details This callback function is invoked whenever the encoder
 * is pressed for more than the long press threshold (1 second
 * by default)
 * @return void
 */
void resetBrightnessCallback() {
  debug << "Brightness reset to 200" << endl;

  setTargetBrightness(200);
}

/**
 * @brief The callback function for encoder events
 * This callback function is invoked whenever the encoder
 * is rotated
 * @param [in] delta The direction of the encoder rotation. +1 or -1 depending
 * on the direction of rotation
 * @return void
 */
void handleEncoderRotationAction(int delta) {
  debug << "Encoder turned by " << delta << endl;

  setTargetBrightness(targetDisplayBrightness + delta);
}

/**
 * @brief A basic signum function *
 * @param [in] val A value of any numerical type
 * @return +1 if val is positive, -1 if negative, and 0 otherwise
 */
template <typename T>
int sgn(T val) {
    return (T(0) < val) - (val < T(0));
}

/**
 * @brief Run the cooperative application loop.
 * @details Delivers queued encoder actions, polls the encoder button, and lets LVGL
 * process touch, drawing, animations, and widget events.
 *
 * @param none.
 * @return void.
 * @note Called continuously by the Arduino runtime.
 */
void loop() {

  // Monitor the status of the encoder and handle actions
  panel.loop();

  // Adjust current brightness to move toward target brightness set by user
  // Note: although the brightness values are uint8_t, delta requires more
  // bits to handle the carry needed for an accurate subtraction
  int16_t delta = targetDisplayBrightness - currentDisplayBrightness;
  int16_t sign = sgn(delta);
  if(sign) {
    currentDisplayBrightness += sign * (abs(delta) >= 20 ? 4 : abs(delta) / 5 + 1);
    panel.setBacklight(currentDisplayBrightness);
    lv_label_set_text_fmt(ui_brightnessLabel, "%d", currentDisplayBrightness);
    lv_arc_set_value(ui_brightnessArc, currentDisplayBrightness);
  }

  // LVGL event loop
  lv_timer_handler();

  vTaskDelay(pdMS_TO_TICKS(15)); 
}
